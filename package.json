{
  "name": "pegass-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Extraction de statistiques des bénévoles depuis Pegass (Croix-Rouge française)",
  "scripts": {
    "lint": "web-ext lint --source-dir=. --ignore-files=package.json package-lock.json README.md LICENSE .gitignore .github/**",
    "build": "web-ext build --source-dir=. --artifacts-dir=web-ext-artifacts --overwrite-dest --filename=pegass-extractor-{version}.zip --ignore-files=package.json package-lock.json README.md LICENSE .gitignore .github/**",
    "start": "web-ext run --source-dir=."
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
