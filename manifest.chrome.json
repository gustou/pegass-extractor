{
  "manifest_version": 3,
  "name": "Pegass Extractor UL",
  "version": "1.2.3",
  "description": "Extraction de statistiques des bénévoles depuis Pegass (Croix-Rouge française)",
  "author": "Augustin (UL Clamart)",
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://pegass.croix-rouge.fr/*"
  ],
  "action": {
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    },
    "default_title": "Pegass Extractor UL",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pegass.croix-rouge.fr/*"
      ],
      "js": [
        "lib/browser-shim.js",
        "content/scraper.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
